{
  "name": "codewiki-vscode",
  "displayName": "CodeWiki - AI Code Knowledge Base",
  "description": "%ext.description%",
  "version": "0.5.1",
  "publisher": "codewiki",
  "license": "MIT",
  "icon": "resources/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/gaosichun888/codewiki.git",
    "directory": "vscode-extension"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other", "Programming Languages", "Visualization"],
  "keywords": ["ai", "code analysis", "ontology", "knowledge graph", "mcp", "code health"],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      { "command": "codewiki.init", "title": "%cmd.init%", "category": "CodeWiki" },
      { "command": "codewiki.healthCheck", "title": "%cmd.healthCheck%", "category": "CodeWiki" },
      { "command": "codewiki.openUsagePanel", "title": "%cmd.openUsagePanel%", "category": "CodeWiki" },
      { "command": "codewiki.openSettings", "title": "%cmd.openSettings%", "category": "CodeWiki" },
      { "command": "codewiki.index", "title": "%cmd.index%", "category": "CodeWiki" },
      { "command": "codewiki.openWiki", "title": "%cmd.openWiki%", "category": "CodeWiki" },
      { "command": "codewiki.searchCode", "title": "%cmd.searchCode%", "category": "CodeWiki" },
      { "command": "codewiki.showGraph", "title": "%cmd.showGraph%", "category": "CodeWiki" },
      { "command": "codewiki.askQuestion", "title": "%cmd.askQuestion%", "category": "CodeWiki" },
      { "command": "codewiki.analyzeImpact", "title": "%cmd.analyzeImpact%", "category": "CodeWiki" },
      { "command": "codewiki.preCheck", "title": "%cmd.preCheck%", "category": "CodeWiki" },
      { "command": "codewiki.showRelations", "title": "%cmd.showRelations%", "category": "CodeWiki" },
      { "command": "codewiki.scan", "title": "%cmd.scan%", "category": "CodeWiki" },
      { "command": "codewiki.patterns", "title": "%cmd.patterns%", "category": "CodeWiki" },
      { "command": "codewiki.generateWiki", "title": "%cmd.generateWiki%", "category": "CodeWiki" },
      { "command": "codewiki.exportWiki", "title": "%cmd.exportWiki%", "category": "CodeWiki" },
      { "command": "codewiki.status", "title": "%cmd.status%", "category": "CodeWiki" },
      { "command": "codewiki.refresh", "title": "%cmd.refresh%", "category": "CodeWiki", "icon": "$(refresh)" },
      { "command": "codewiki.clearDiagnostics", "title": "%cmd.clearDiagnostics%", "category": "CodeWiki", "icon": "$(clear-all)" },
      { "command": "codewiki.goToEntity", "title": "%cmd.goToEntity%", "category": "CodeWiki" }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codewiki",
          "title": "CodeWiki",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "codewiki": [
        { "type": "webview", "id": "codewiki.usagePanel", "name": "%view.usagePanel%" },
        { "id": "codewiki.wikiPages", "name": "%view.wikiPages%" },
        { "id": "codewiki.entities", "name": "%view.entities%" }
      ]
    },
    "menus": {
      "view/title": [
        { "command": "codewiki.init", "when": "view == codewiki.usagePanel", "group": "navigation@1" },
        { "command": "codewiki.healthCheck", "when": "view == codewiki.usagePanel", "group": "navigation@2" },
        { "command": "codewiki.refresh", "when": "view == codewiki.entities", "group": "navigation@1" }
      ],
      "editor/context": [
        { "command": "codewiki.preCheck", "when": "editorTextFocus", "group": "codewiki@1" },
        { "command": "codewiki.analyzeImpact", "when": "editorTextFocus", "group": "codewiki@2" },
        { "command": "codewiki.showRelations", "when": "editorTextFocus", "group": "codewiki@3" }
      ],
      "commandPalette": [
        { "command": "codewiki.clearDiagnostics", "when": "true" },
        { "command": "codewiki.goToEntity", "when": "false" }
      ]
    },
    "keybindings": [
      { "command": "codewiki.searchCode", "key": "ctrl+alt+s", "mac": "cmd+alt+s" },
      { "command": "codewiki.healthCheck", "key": "ctrl+alt+h", "mac": "cmd+alt+h" },
      { "command": "codewiki.preCheck", "key": "ctrl+alt+p", "mac": "cmd+alt+p", "when": "editorTextFocus" }
    ],
    "walkthroughs": [
      {
        "id": "codewiki.getStarted",
        "title": "%walkthrough.title%",
        "description": "%walkthrough.description%",
        "steps": [
          {
            "id": "codewiki.step.init",
            "title": "%walkthrough.step.init%",
            "description": "%walkthrough.step.init.desc%\n[%cmd.init%](command:codewiki.init)",
            "media": { "markdown": "walkthroughs/init.md" }
          },
          {
            "id": "codewiki.step.health",
            "title": "%walkthrough.step.health%",
            "description": "%walkthrough.step.health.desc%\n[%cmd.healthCheck%](command:codewiki.healthCheck)",
            "media": { "markdown": "walkthroughs/health.md" }
          },
          {
            "id": "codewiki.step.usage",
            "title": "%walkthrough.step.usage%",
            "description": "%walkthrough.step.usage.desc%\n[%cmd.openUsagePanel%](command:codewiki.openUsagePanel)",
            "media": { "markdown": "walkthroughs/usage.md" }
          }
        ]
      }
    ],
    "configuration": {
      "title": "CodeWiki",
      "properties": {
        "codewiki.language": {
          "type": "string",
          "default": "auto",
          "enum": ["auto", "en", "zh"],
          "enumDescriptions": [
            "Follow VS Code display language / 跟随 VS Code 界面语言",
            "English",
            "中文"
          ],
          "description": "%config.language%"
        },
        "codewiki.llmProvider": {
          "type": "string",
          "default": "openai",
          "enum": ["openai", "anthropic", "deepseek", "ollama"],
          "description": "%config.llmProvider%"
        },
        "codewiki.apiKey": {
          "type": "string",
          "default": "",
          "description": "%config.apiKey%"
        },
        "codewiki.model": {
          "type": "string",
          "default": "gpt-4o",
          "description": "%config.model%"
        },
        "codewiki.cliPath": {
          "type": "string",
          "default": "npx tsx",
          "description": "%config.cliPath%"
        },
        "codewiki.autoIndex": {
          "type": "boolean",
          "default": true,
          "description": "%config.autoIndex%"
        },
        "codewiki.codeLens": {
          "type": "boolean",
          "default": true,
          "description": "%config.codeLens%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package --no-dependencies -o codewiki-vscode-0.5.1.vsix"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^20.0.0",
    "@vscode/vsce": "^3.0.0",
    "typescript": "^5.3.0"
  }
}
